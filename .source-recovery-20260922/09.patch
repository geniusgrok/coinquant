--- /dev/null
+++ b/tests/test_sustainable_capital.py
@@ -0,0 +1,74 @@
+import unittest
+from dataclasses import replace
+from decimal import Decimal as D
+
+from pancakequant.capital import CapitalBudget, HOUR, capital_surplus, gap_margin, sustain_position
+from pancakequant.linear_account import Account, FEE
+from pancakequant.linear_sizing import funded_target
+from research.bounded_execution import BoundedEntry, exit_fill
+
+
+class CapitalTests(unittest.TestCase):
+    def budget(self, rate='.0001'):
+        return CapitalBudget.from_history(9*HOUR, {0:D(rate),8*HOUR:D(rate)}, D('1000000'),D('.001'),D('.0002'))
+
+    def test_future_settlement_and_unpublished_rate_cannot_change_budget(self):
+        now=8*HOUR+30000
+        a={0:D('.0001'),8*HOUR:D('.0009'),16*HOUR:D('2')}
+        b={0:D('.0001'),8*HOUR:D('8'),16*HOUR:D('9')}
+        args=(D('1000000'),D('.001'),D('.0002'))
+        self.assertEqual(CapitalBudget.from_history(now,a,*args),CapitalBudget.from_history(now,b,*args))
+        self.assertEqual(self.budget(),CapitalBudget.restore(self.budget().record()))
+
+    def test_missing_stale_and_slot_gap_are_not_spendable(self):
+        for now,history in ((0,{}),(20*HOUR,{0:D('.0001')}),(25*HOUR,{0:D('.0001'),24*HOUR:D('.0001')})):
+            b=CapitalBudget.from_history(now,history,D(1000000),D('.001'),D('.0002'))
+            self.assertFalse(b.valid)
+            self.assertFalse(b.reserve(D(1),D(100),D(100),D(100)).is_finite())
+
+    def test_original_one_percent_floor_is_not_removed_or_double_counted(self):
+        a=self.budget('0');b=self.budget('.0001');c=self.budget('.001')
+        self.assertEqual(a.reserve(D(1),D(100),D(100),D(100)),b.reserve(D(1),D(100),D(100),D(100)))
+        self.assertEqual(c.reserve(D(1),D(100),D(100),D(100))-b.reserve(D(1),D(100),D(100),D(100)),D('1.210'))
+
+    def test_shared_funding_retains_draw_from_margin(self):
+        a=Account(D(100),D(1),D(100),D(99),D(80),D(140));b=replace(a)
+        a.pay_funding(D(100),D('.02'));b.apply_funding_cost(D(2))
+        self.assertEqual(a,b);self.assertEqual(a.margin,D(98));self.assertEqual(a.equity(D(100)),D(98))
+
+    def test_sizing_shrinks_only_when_funds_bind(self):
+        b=self.budget('.002')
+        rich=Account(D(10000));old=replace(rich)
+        args=(1,D(1),D(100),D(100),D(80),D(140),D(100),None)
+        funded_target(rich,*args,capital=b);funded_target(old,*args)
+        self.assertLessEqual(rich.q,old.q)
+        self.assertGreater(rich.q,0)
+        self.assertGreaterEqual(rich.wallet-rich.margin,b.reserve(rich.q,rich.entry,D(100),D(100)))
+
+    def test_partial_reduction_conserves_cash_preserves_anchor_and_never_readds(self):
+        a=Account(D(32),D(1),D(100),D(31),D(80),D(140));old=replace(a)
+        b=self.budget('.001');quote=D(105)
+        fill=lambda q:exit_fill(quote,q,D(1000000),D('.001'),D('.0002'))[0]
+        r=sustain_position(a,b,quote,quote,D(100),None,fill)
+        self.assertGreater(r['amount'],0);self.assertLess(r['amount'],1)
+        self.assertEqual(a.wallet,old.wallet+r['amount']*(r['price']-old.entry)-r['amount']*r['price']*FEE)
+        self.assertEqual((a.sl,a.tp,a.entry),(old.sl,old.tp,old.entry))
+        self.assertGreaterEqual(capital_surplus(a,b,quote,quote,D(100)),0)
+        before=replace(a)
+        self.assertEqual(sustain_position(a,b,quote,quote,D(100),None,fill)['amount'],0)
+        self.assertEqual(a,before)
+        self.assertEqual(gap_margin(a,D(100))[1],D(70))
+
+    def test_equity_alone_is_not_cash_for_more_risk(self):
+        a=Account(D(32),D(1),D(100),D(31),D(80),D(200))
+        b=self.budget('.001')
+        self.assertLess(capital_surplus(a,b,D(150),D(150),D(100)),0)
+
+    def test_parent_budget_survives_restart(self):
+        a=Account(D(1000));b=self.budget()
+        p=BoundedEntry.freeze(a,9*HOUR,1,D(3),D(100),D(100),D(80),D(140),D(1000000),None,D('.001'),D('.0002'),capital=b,budget=D(6))
+        q=BoundedEntry.restore(p.record())
+        self.assertEqual(q.record(),p.record())
+
+
+if __name__=='__main__':unittest.main()
